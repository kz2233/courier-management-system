<IfModule mod_ssl.c>
<VirtualHost *:443>
    ServerName {{ server_name }}
    DocumentRoot /var/www/html

    SSLEngine on
    SSLCertificateFile /etc/ssl/certs/courier-remediation.crt
    SSLCertificateKeyFile /etc/ssl/private/courier-remediation.key
    SSLProtocol all -SSLv3 -TLSv1 -TLSv1.1

    Header always set Strict-Transport-Security "max-age=31536000"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    <Directory /var/www/html>
        AllowOverride All
        Require all granted
    </Directory>

    ErrorLog ${APACHE_LOG_DIR}/courier-error.log
    CustomLog ${APACHE_LOG_DIR}/courier-access.log combined
</VirtualHost>
</IfModule>
